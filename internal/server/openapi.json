{
  "openapi": "3.0.3",
  "info": {
    "title": "CareerRadar API",
    "version": "0.1.0",
    "description": "Work in progress. All endpoints require HTTP Basic authentication; bind to localhost or use HTTPS through a trusted proxy."
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "page_url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "work_mode": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "match": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "source_id": {
            "type": "integer",
            "format": "int64"
          },
          "hours": {
            "type": "integer",
            "nullable": true
          },
          "salary": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Monthly amount in currency"
          },
          "salary_min": {"type":"integer","format":"int64","nullable":true,"description":"Minimum monthly amount in currency"},
          "salary_max": {"type":"integer","format":"int64","nullable":true,"description":"Maximum monthly amount in currency"},
          "closed": {
            "type": "boolean"
          },
          "direction": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "description": "Recognized programming languages separated by comma; empty when unknown"
          },
          "apply_url": {"type":"string","description":"Source-provided application URL; empty when unknown"}
        }
      },
      "DiscoveryResult": {
        "type":"object",
        "required":["title","company","url","location","work_mode","source","description","archived"],
        "properties": {
          "title":{"type":"string"},
          "company":{"type":"string"},
          "url":{"type":"string","format":"uri"},
          "location":{"type":"string","description":"Empty when not explicitly extracted"},
          "work_mode":{"type":"string","enum":["","remote"],"description":"Published RSS or card work mode"},
          "source":{"type":"string","enum":["Хабр Карьера"]},
          "description":{"type":"string","description":"Plain text without scripts or styles"},
          "archived":{"type":"boolean","description":"Archive confirmed by the exact Habr vacancy page"},
          "problem":{"type":"string","description":"Card retrieval or incomplete-data warning"}
        }
      },
      "Preferences": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "levels": {"type":"array","items":{"type":"string"}},
          "directions": {"type":"array","items":{"type":"string"}},
          "locations": {"type":"array","items":{"type":"string"}},
          "types": {"type":"array","items":{"type":"string"}},
          "languages": {"type":"array","items":{"type":"string"}},
          "companies": {"type":"array","items":{"type":"string"}},
          "work_modes": {"type":"array","items":{"type":"string"}},
          "max_hours": {"type":"integer","minimum":0,"maximum":168,"nullable":true},
          "min_salary": {"type":"integer","format":"int64","minimum":0,"nullable":true,"description":"Optional minimum monthly salary"},
          "max_salary": {"type":"integer","format":"int64","minimum":0,"nullable":true,"description":"Optional maximum monthly salary"},
          "currency": {"type":"string","description":"Required when either salary limit is set"}
        }
      }
    }
  },
  "paths": {
    "/api/sources": {
      "get": {
        "summary": "List sources",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        }
      },
      "post": {
        "summary": "Create an unconfirmed source",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "url"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/{id}": {
      "put": {
        "summary": "Edit or confirm a source",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "url"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a source without deleting collected jobs",
        "responses": {
          "204": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ]
      }
    },
    "/api/sources/{id}/check": {
      "post": {
        "summary": "Manually check a confirmed source",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ]
      }
    },
    "/api/sources/import": {
      "post": {
        "summary": "Import pending sources from CSV",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "type": "string",
                "example": "name,url\\nExample,https://example.com/careers"
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "List opportunities",
        "parameters": [
          {"in":"query","name":"q","schema":{"type":"string","maxLength":100},"description":"Search title and company"},
          {"in":"query","name":"level","schema":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":100}},"style":"form","explode":true},
          {"in":"query","name":"direction","schema":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":100}},"style":"form","explode":true},
          {"in":"query","name":"language","schema":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":100}},"style":"form","explode":true},
          {"in":"query","name":"company","schema":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":100}},"style":"form","explode":true},
          {"in":"query","name":"location","schema":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":100}},"style":"form","explode":true},
          {"in":"query","name":"type","schema":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":100}},"style":"form","explode":true},
          {"in":"query","name":"work_mode","schema":{"type":"array","maxItems":20,"items":{"type":"string","maxLength":100}},"style":"form","explode":true},
          {"in":"query","name":"limit","schema":{"type":"integer","minimum":1,"maximum":100,"default":50},"description":"Page size"},
          {"in":"query","name":"cursor","schema":{"type":"integer","format":"int64","minimum":1},"description":"Continue after the last raw catalog row scanned in X-Next-Cursor"}
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "X-Has-More": {"schema":{"type":"boolean"},"description":"True when more SQL-filtered rows remain to scan; after processing 5,000 rows, a one-row probe checks for more, which may not match preferences"},
              "X-Next-Cursor": {"schema":{"type":"integer","format":"int64"},"description":"Cursor for the next request; pass as the cursor query parameter"}
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        }
      }
    },
    "/api/jobs/{id}/status": {
      "put": {
        "summary": "Update application status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "Не откликался",
                      "Откликнулся",
                      "Тестовое",
                      "Собеседование",
                      "Оффер",
                      "Отказ"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/telegram/link": {
      "post": {
        "summary": "Generate a one-use Telegram linking code valid for ten minutes",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        }
      }
    },
    "/api/discovery": {
      "get": {
        "summary": "Search public Habr Career RSS listings",
        "description": "Return up to 20 provider results whose title or plain description contains the query, ignoring case and repeated whitespace. An empty result is valid. This is a bounded provider search, not an exhaustive web search.",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attributed results",
            "content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/DiscoveryResult"}}}}
          },
          "400": {
            "description": "Invalid query"
          },
          "502": {
            "description": "Source unavailable"
          }
        }
      },
      "post": {
        "summary": "Search Habr Career and save results without enabling monitoring",
        "description": "Apply the same title/description relevance check as GET. Save only matching results, preserving explicit title type and level labels; new sources stay disabled. Archived results update only previously saved vacancies. Discovery and potentially overlapping source checks are coordinated within the shared monitor service instance.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attributed search results saved",
            "content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/DiscoveryResult"}}}}
          },
          "400": {
            "description": "Invalid query"
          },
          "408": {
            "description": "Search cancelled while waiting for another Habr update"
          },
          "502": {
            "description": "Search unavailable"
          },
          "415": {
            "description": "Expected application/json"
          },
          "500": {
            "description": "Could not save discovery results"
          }
        }
      }
    },
    "/api/checks": {
      "get": {
        "summary": "List recent source checks",
        "responses": {
          "200": {
            "description": "Latest 100 checks"
          }
        }
      }
    },
    "/api/preferences": {
      "get": {
        "summary": "Get preferences",
        "responses": {
          "200": {
            "description": "Current preferences",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Preferences"}}}
          }
        }
      },
      "put": {
        "summary": "Replace preferences",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved preferences",
            "content": {"application/json":{"schema":{"$ref":"#/components/schemas/Preferences"}}}
          },
          "400": {
            "description": "Invalid preferences"
          }
        }
      }
    },
    "/api/discovery/company": {
      "get": {
        "summary": "Find unconfirmed company career links via Wikidata",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate links"
          },
          "400": {
            "description": "Invalid query"
          },
          "502": {
            "description": "Discovery unavailable"
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "summary": "Get a job, its history and evidence",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    },
                    "history": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "snapshot": {
                            "type": "object"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/jobs/{id}/close": {
      "post": {
        "summary": "Record owner-confirmed closure with evidence",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "evidence"
                ],
                "properties": {
                  "evidence": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed"
          },
          "400": {
            "description": "Invalid evidence"
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/api/jobs/{id}/reopen": {
      "post": {
        "summary": "Remove an incorrect or outdated closure confirmation",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Closure removed"
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/api/notifications/uncertain": {
      "get": {
        "summary": "List delivery outcomes awaiting owner review",
        "responses": {
          "200": {
            "description": "Uncertain notifications"
          }
        }
      }
    },
    "/api/notifications/{id}/resolve": {
      "post": {
        "summary": "Explicitly mark delivered or request retry",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "sent",
                      "retry"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved"
          },
          "409": {
            "description": "Notification is not awaiting review"
          }
        }
      }
    }
  }
}
