{
  "openapi": "3.0.3",
  "info": {
    "title": "CareerRadar API",
    "version": "0.1.0",
    "description": "Work in progress. All endpoints require HTTP Basic authentication; bind to localhost or use HTTPS through a trusted proxy."
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Job": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "page_url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "work_mode": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "match": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "source_id": {
            "type": "integer",
            "format": "int64"
          },
          "hours": {
            "type": "integer",
            "nullable": true
          },
          "salary": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Monthly amount in currency"
          },
          "salary_min": {"type":"integer","format":"int64","nullable":true,"description":"Minimum monthly amount in currency"},
          "salary_max": {"type":"integer","format":"int64","nullable":true,"description":"Maximum monthly amount in currency"},
          "closed": {
            "type": "boolean"
          },
          "direction": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "description": "Recognized programming languages separated by comma; empty when unknown"
          }
        }
      }
    }
  },
  "paths": {
    "/api/sources": {
      "get": {
        "summary": "List sources",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        }
      },
      "post": {
        "summary": "Create an unconfirmed source",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "url"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/{id}": {
      "put": {
        "summary": "Edit or confirm a source",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "url"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a source without deleting collected jobs",
        "responses": {
          "204": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ]
      }
    },
    "/api/sources/{id}/check": {
      "post": {
        "summary": "Manually check a confirmed source",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ]
      }
    },
    "/api/sources/import": {
      "post": {
        "summary": "Import pending sources from CSV",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "type": "string",
                "example": "name,url\\nExample,https://example.com/careers"
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "List opportunities",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        }
      }
    },
    "/api/jobs/{id}/status": {
      "put": {
        "summary": "Update application status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "Не откликался",
                      "Откликнулся",
                      "Тестовое",
                      "Собеседование",
                      "Оффер",
                      "Отказ"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/telegram/link": {
      "post": {
        "summary": "Generate a one-use Telegram linking code valid for ten minutes",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        }
      }
    },
    "/api/discovery": {
      "get": {
        "summary": "Search public Remotive listings",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attributed results"
          },
          "400": {
            "description": "Invalid query"
          },
          "502": {
            "description": "Source unavailable"
          }
        }
      },
      "post": {
        "summary": "Search Remotive and save results without enabling monitoring",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Attributed search results saved"
          },
          "400": {
            "description": "Invalid query"
          },
          "502": {
            "description": "Search unavailable"
          }
        }
      }
    },
    "/api/checks": {
      "get": {
        "summary": "List recent source checks",
        "responses": {
          "200": {
            "description": "Latest 100 checks"
          }
        }
      }
    },
    "/api/preferences": {
      "get": {
        "summary": "Get preferences",
        "responses": {
          "200": {
            "description": "Current preferences"
          }
        }
      },
      "put": {
        "summary": "Replace preferences",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved preferences"
          },
          "400": {
            "description": "Invalid preferences"
          }
        }
      }
    },
    "/api/discovery/company": {
      "get": {
        "summary": "Find unconfirmed company career links via Wikidata",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate links"
          },
          "400": {
            "description": "Invalid query"
          },
          "502": {
            "description": "Discovery unavailable"
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "summary": "Get a job, its history and evidence",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/Job"
                    },
                    "history": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "snapshot": {
                            "type": "object"
                          },
                          "created_at": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uri"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/jobs/{id}/close": {
      "post": {
        "summary": "Record owner-confirmed closure with evidence",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "evidence"
                ],
                "properties": {
                  "evidence": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmed"
          },
          "400": {
            "description": "Invalid evidence"
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/api/jobs/{id}/reopen": {
      "post": {
        "summary": "Remove an incorrect or outdated closure confirmation",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Closure removed"
          },
          "404": {
            "description": "Job not found"
          }
        }
      }
    },
    "/api/notifications/uncertain": {
      "get": {
        "summary": "List delivery outcomes awaiting owner review",
        "responses": {
          "200": {
            "description": "Uncertain notifications"
          }
        }
      }
    },
    "/api/notifications/{id}/resolve": {
      "post": {
        "summary": "Explicitly mark delivered or request retry",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "sent",
                      "retry"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resolved"
          },
          "409": {
            "description": "Notification is not awaiting review"
          }
        }
      }
    }
  }
}
