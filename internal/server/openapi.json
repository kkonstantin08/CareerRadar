{
  "openapi": "3.0.3",
  "info": {
    "title": "CareerRadar API",
    "version": "0.1.0",
    "description": "Work in progress. All endpoints require HTTP Basic authentication; bind to localhost or use HTTPS through a trusted proxy."
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "paths": {
    "/api/sources": {
      "get": {
        "summary": "List sources",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        }
      },
      "post": {
        "summary": "Create an unconfirmed source",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "url"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sources/{id}": {
      "put": {
        "summary": "Edit or confirm a source",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "url"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a source without deleting collected jobs",
        "responses": {
          "204": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ]
      }
    },
    "/api/sources/{id}/check": {
      "post": {
        "summary": "Manually check a confirmed source",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ]
      }
    },
    "/api/sources/import": {
      "post": {
        "summary": "Import pending sources from CSV",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "type": "string",
                "example": "name,url\\nExample,https://example.com/careers"
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "get": {
        "summary": "List opportunities",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        }
      }
    },
    "/api/jobs/{id}/status": {
      "put": {
        "summary": "Update application status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "status"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "Не откликался",
                      "Откликнулся",
                      "Тестовое",
                      "Собеседование",
                      "Оффер",
                      "Отказ"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/telegram/link": {
      "post": {
        "summary": "Generate a one-use Telegram linking code valid for ten minutes",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "500": {
            "description": "Database error"
          }
        }
      }
    },
    "/api/discovery": {
      "get": {
        "summary": "Search public Remotive listings",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Attributed results"
          },
          "400": {
            "description": "Invalid query"
          },
          "502": {
            "description": "Source unavailable"
          }
        }
      }
    },
    "/api/checks": {
      "get": {
        "summary": "List recent source checks",
        "responses": {
          "200": {
            "description": "Latest 100 checks"
          }
        }
      }
    },
    "/api/preferences": {
      "get": {
        "summary": "Get preferences",
        "responses": {
          "200": {
            "description": "Current preferences"
          }
        }
      },
      "put": {
        "summary": "Replace preferences",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved preferences"
          },
          "400": {
            "description": "Invalid preferences"
          }
        }
      }
    },
    "/api/discovery/company": {
      "get": {
        "summary": "Find unconfirmed company career links via Wikidata",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate links"
          },
          "400": {
            "description": "Invalid query"
          },
          "502": {
            "description": "Discovery unavailable"
          }
        }
      }
    },
    "/api/jobs/{id}": {
      "get": {
        "summary": "Get a job, its history and evidence",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job details"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  }
}
